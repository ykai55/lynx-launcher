From: Lynx Launcher maintainers
Subject: [PATCH] Fix Linux windowless teardown ordering

Keep service destruction on live task runners and let pending task closures
finish their own cleanup before the embedder runner is marked unavailable.
Reject reentrant work during destruction so cleanup cannot strand new tasks.

This is a narrow integration patch for the pinned Linux windowless SDK.

diff --git a/clay/shell/platform/embedder/BUILD.gn b/clay/shell/platform/embedder/BUILD.gn
--- a/clay/shell/platform/embedder/BUILD.gn
+++ b/clay/shell/platform/embedder/BUILD.gn
@@ -96,3 +96,21 @@ template("embedder_source_set") {
 embedder_source_set("embedder") {
   public_configs = []
 }
+
+if (enable_unittests && is_linux) {
+  executable("embedder_task_runner_unittests") {
+    testonly = true
+    sources = [ "embedder_task_runner_unittests.cc" ]
+    deps = [
+      ":embedder",
+      "../../../testing",
+      "../../../testing:testing_fixtures",
+      "../../../../base/src:base_static",
+    ]
+
+    libs = [
+      "epoxy",
+      "rt",
+    ]
+  }
+}
